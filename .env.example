APP_URL=https://your-app.vercel.app

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
# Use a separate random secret of at least 32 characters.
OAUTH_STATE_SECRET=replace-with-a-long-random-secret

META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_GRAPH_VERSION=v22.0
# Register this exact callback URL in both provider apps.
META_REDIRECT_URI=https://your-app.vercel.app/api/oauth
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://your-app.vercel.app/api/oauth